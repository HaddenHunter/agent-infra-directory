---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import UseCaseCard from '../../components/UseCaseCard.astro';
import { t, SITE_URL, type Locale } from '../../i18n/ui';
import { useCaseScenarios, useCaseScenarioKeys, type UseCaseScenario } from '../../lib/use-cases';

const locale: Locale = 'en';
const s = t(locale);

const items = (await getCollection('useCases')).sort((a, b) =>
  b.data.sourceDate.localeCompare(a.data.sourceDate)
);

const counts = Object.fromEntries(
  useCaseScenarioKeys.map((k) => [k, items.filter((e) => e.data.scenario === k).length])
) as Record<UseCaseScenario, number>;

const latest = items[0]?.data.sourceDate ?? '';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Real-world agent use cases — ${s.siteName}`,
  url: `${SITE_URL}/use-cases/`,
  numberOfItems: items.length,
  inLanguage: 'en',
};
---

<BaseLayout
  locale={locale}
  title={`Real-world agent use cases — ${s.siteName}`}
  description="Traced accounts of people handing real tasks to agents — medical admin, bills, travel, family — each with a named source, a date and an explicit verification status."
  path="/use-cases/"
  alternates={{ en: '/use-cases/', zh: '/zh/use-cases/' }}
  jsonLd={jsonLd}
>
  <nav class="text-sm text-slate-500 dark:text-slate-400">
    <a class="hover:text-slate-900 dark:hover:text-slate-100" href="/">{s.home}</a>
    <span class="mx-1">/</span>
    <span>Use cases</span>
  </nav>

  <header class="mt-3">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-50">
      Real-world agent use cases
    </h1>
    <p class="mt-2 max-w-3xl text-slate-600 dark:text-slate-400">
      Accounts of people handing a real task to an agent — an insurer phone call, a duplicate
      subscription, a family schedule. Each entry names its source and date, and carries an
      explicit verification status. Stories that could not be traced are kept and labelled, not
      quietly dropped.
    </p>
    <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
      {items.length} entries · {s.lastUpdated} {latest}
    </p>
  </header>

  <div class="mt-6 flex flex-wrap gap-2">
    {
      useCaseScenarioKeys.map((k) => (
        <span class="badge badge-neutral">
          {useCaseScenarios[k][locale]} ({counts[k]})
        </span>
      ))
    }
  </div>

  <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {items.map((useCase) => <UseCaseCard locale={locale} useCase={useCase} />)}
  </div>

  <aside class="mt-10 rounded-xl border border-slate-200 bg-white p-5 text-sm text-slate-600 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400">
    <strong class="text-slate-900 dark:text-slate-100">Sources, not summaries.</strong>{' '}
    A widely repeated story is exactly the kind of thing that gets rewritten in circulation. Where a
    circulated version could not be traced back to the original, the entry says so —
    <a class="underline" href="/myths/">see the myth-check page →</a>
  </aside>
</BaseLayout>
