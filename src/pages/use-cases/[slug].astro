---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { faqSchema } from '../../lib/schema';
import { t, type Locale } from '../../i18n/ui';
import { useCaseScenarios, useCaseUrl } from '../../lib/use-cases';
import { verificationBadge, verificationLabels, type Verification } from '../../lib/news';

export async function getStaticPaths() {
  const useCases = await getCollection('useCases');
  return useCases.map((u) => ({ params: { slug: u.id }, props: { useCase: u } }));
}

const { useCase } = Astro.props as {
  useCase: Awaited<ReturnType<typeof getCollection<'useCases'>>>[number];
};
const locale: Locale = 'en';
const s = t(locale);
const d = useCase.data;

const scenarioLabel = useCaseScenarios[d.scenario].en;
const vLabel = verificationLabels[d.verification as Verification].en;
const vClass = verificationBadge[d.verification as Verification];

const qas = [
  { q: `What happened in this ${d.product} use case?`, a: d.summary },
  { q: `Is this account verified?`, a: `${vLabel} — ${d.outcome}` },
  { q: `What is the source?`, a: `${d.sourceName}, published ${d.sourceDate}: ${d.sourceUrl}` },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    about: d.product,
    datePublished: d.sourceDate,
    inLanguage: 'en',
    isBasedOn: d.sourceUrl,
    publisher: { '@type': 'Organization', name: d.sourceName },
  },
  faqSchema(qas),
];
---

<BaseLayout
  locale={locale}
  title={`${d.title} — ${scenarioLabel}`}
  description={d.summary}
  path={useCaseUrl(locale, useCase.id)}
  alternates={{ en: useCaseUrl('en', useCase.id), zh: useCaseUrl('zh', useCase.id) }}
  jsonLd={jsonLd}
  ogType="article"
>
  <nav class="text-sm text-slate-500 dark:text-slate-400">
    <a class="hover:text-slate-900 dark:hover:text-slate-100" href="/">{s.home}</a>
    <span class="mx-1">/</span>
    <a class="hover:text-slate-900 dark:hover:text-slate-100" href="/use-cases/">Use cases</a>
  </nav>

  <header class="mt-3">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-50">
      {d.title}
    </h1>
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <span class="badge badge-cat">{scenarioLabel}</span>
      <span class={`badge ${vClass}`}>{vLabel}</span>
      <span class="badge badge-neutral">{d.product}</span>
      <span class="badge badge-neutral tabular-nums">{d.sourceDate}</span>
    </div>
  </header>

  <blockquote class="key-fact mt-6">
    <p class="text-[15px] leading-relaxed">{d.keyFact}</p>
  </blockquote>

  {
    d.debunks && (
      <p class="alert-caveat mt-4">
        <strong>This claim was checked: </strong>
        {d.debunks}
        <a class="underline" href="/myths/">Myth check →</a>
      </p>
    )
  }

  <section class="mt-8">
    <h2 class="section-title">What happened</h2>
    <p class="mt-3 text-slate-700 dark:text-slate-300">{d.summary}</p>
  </section>

  <section class="mt-8">
    <h2 class="section-title">Why this scenario was tested</h2>
    <p class="mt-3 text-slate-700 dark:text-slate-300">{d.background}</p>
  </section>

  {
    d.actions.length > 0 && (
      <section class="mt-8">
        <h2 class="section-title">What the agent did</h2>
        <table class="facts-table mt-3">
          <tbody>
            {d.actions.map((row) => (
              <tr>
                <th>{row.label}</th>
                <td>{row.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    )
  }

  <section class="mt-8">
    <h2 class="section-title">Outcome</h2>
    <p class="mt-3 text-slate-700 dark:text-slate-300">{d.outcome}</p>
  </section>

  {
    d.caveat && (
      <p class="alert-caveat mt-6">
        <strong>Caveat: </strong>
        {d.caveat}
      </p>
    )
  }

  <section class="mt-8">
    <h2 class="section-title">{s.facts}</h2>
    <table class="facts-table mt-3">
      <tbody>
        <tr>
          <th>Product</th>
          <td>{d.product}</td>
        </tr>
        <tr>
          <th>{s.verification}</th>
          <td>{vLabel}</td>
        </tr>
        <tr>
          <th>{s.newsSource}</th>
          <td>
            <a class="underline hover:text-indigo-600" href={d.sourceUrl} rel="nofollow noopener">
              {d.sourceName}
            </a>
            <span class="ml-2 text-slate-500 tabular-nums">{d.sourceDate}</span>
          </td>
        </tr>
      </tbody>
    </table>
  </section>

  <section class="mt-10">
    <h2 class="section-title">FAQ</h2>
    <div class="mt-4 space-y-3">
      {
        qas.map(({ q, a }) => (
          <details class="card !p-0">
            <summary class="cursor-pointer px-4 py-3 font-medium text-slate-900 dark:text-slate-100">
              {q}
            </summary>
            <p class="px-4 pb-4 text-sm text-slate-600 dark:text-slate-400">{a}</p>
          </details>
        ))
      }
    </div>
  </section>
</BaseLayout>
