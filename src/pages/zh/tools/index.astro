---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ToolCard from '../../../components/ToolCard.astro';
import { categories, categoryKeys, t, SITE_URL } from '../../../i18n/ui';

const locale = 'zh' as const;
const s = t(locale);
const tools = (await getCollection('tools')).sort(
  (a, b) => (b.data.stars ?? 0) - (a.data.stars ?? 0)
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `全部工具 — ${s.siteName}`,
  url: `${SITE_URL}/zh/tools/`,
  numberOfItems: tools.length,
  inLanguage: 'zh-CN',
};
---

<BaseLayout
  locale={locale}
  title={`全部 ${tools.length} 个工具 — ${s.siteName}`}
  description={`浏览全部 ${tools.length} 个 AI Agent 基础设施工具，可按分类筛选，附已核验事实与可引用判断句。`}
  path="/zh/tools/"
  alternates={{ en: '/tools/', zh: '/zh/tools/' }}
  jsonLd={jsonLd}
>
  <div id="tools-search-root" data-unit="个工具">
    <header class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-50">
          全部工具
        </h1>
        <p class="mt-1 text-slate-600 dark:text-slate-400">
          <span id="tool-count">{tools.length} / {tools.length} {s.tools}</span>
        </p>
      </div>
      <label class="relative w-full max-w-sm">
        <span class="sr-only">搜索工具</span>
        <input
          id="tool-search"
          type="search"
          placeholder="搜索名称、许可证、语言…"
          class="w-full rounded-lg border border-slate-300 bg-white py-2 pl-9 pr-3 text-sm
            placeholder:text-slate-400 focus:border-indigo-500 focus:outline-none focus:ring-2
            focus:ring-indigo-200 dark:border-slate-700 dark:bg-slate-900 dark:focus:ring-indigo-900"
        />
        <svg
          class="pointer-events-none absolute left-3 top-2.5 h-4 w-4 text-slate-400"
          viewBox="0 0 20 20"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z"
            clip-rule="evenodd"></path>
        </svg>
      </label>
    </header>

    <div class="mt-6 flex flex-wrap gap-2">
      <button
        type="button"
        data-filter-cat="all"
        aria-pressed="true"
        class="filter-chip badge badge-cat cursor-pointer ring-1 ring-transparent">全部</button
      >
      {
        categoryKeys.map((k) => (
          <button
            type="button"
            data-filter-cat={k}
            aria-pressed="false"
            class="filter-chip badge badge-neutral cursor-pointer ring-1 ring-transparent"
          >
            {categories[k].zh}
          </button>
        ))
      }
    </div>

    <div id="tool-grid" class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {tools.map((tool) => <ToolCard locale={locale} tool={tool} />)}
    </div>

    <p id="tool-empty" class="mt-10 hidden rounded-xl border border-dashed border-slate-300 p-10 text-center text-slate-500 dark:border-slate-700">
      没有符合条件的工具。
    </p>
  </div>

  <style>
    .filter-chip[aria-pressed='true'] {
      background-color: var(--color-indigo-600);
      color: #fff;
    }
  </style>

  <script>
    function initToolsFilter() {
      const root = document.getElementById('tools-search-root');
      if (!root || root.dataset.bound === '1') return;
      root.dataset.bound = '1';

      const input = root.querySelector('#tool-search');
      const grid = root.querySelector('#tool-grid');
      const empty = root.querySelector('#tool-empty');
      const countEl = root.querySelector('#tool-count');
      const chips = Array.from(root.querySelectorAll('[data-filter-cat]'));
      const cards = Array.from(grid.querySelectorAll('[data-search]'));
      const total = cards.length;
      const unit = root.dataset.unit || 'tools';
      let activeCat = 'all';

      const params = new URLSearchParams(location.search);
      const initialQ = params.get('q');
      if (initialQ && input) input.value = initialQ;

      function apply() {
        const q = (input && input.value ? input.value : '').trim().toLowerCase();
        let visible = 0;
        for (const card of cards) {
          const matchCat = activeCat === 'all' || card.dataset.cat === activeCat;
          const matchQ = !q || (card.dataset.search || '').includes(q);
          const show = matchCat && matchQ;
          card.style.display = show ? '' : 'none';
          if (show) visible++;
        }
        if (empty) empty.style.display = visible === 0 ? '' : 'none';
        if (countEl) countEl.textContent = visible + ' / ' + total + ' ' + unit;
      }

      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          activeCat = chip.dataset.filterCat;
          chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
          apply();
        });
      });

      if (input) input.addEventListener('input', apply);
      apply();
    }
    initToolsFilter();
    document.addEventListener('astro:after-swap', initToolsFilter);
  </script>
</BaseLayout>
