---
import { getCollection, getEntry } from 'astro:content';
import ComparisonPage from '../../../components/ComparisonPage.astro';
import {
  derivedView,
  editorialView,
  selectDerivedPairs,
  type ComparisonView,
} from '../../../lib/comparisons';

/** 挑选规则与英文路由完全一致，保证两边 slug 一一对应 */
export async function getStaticPaths() {
  const tools = await getCollection('tools');
  const comparisons = await getCollection('comparisons');

  const editorial = comparisons.map((c) => editorialView(c));
  const taken = new Set(editorial.map((c) => c.slug));
  const derived = selectDerivedPairs(tools, taken).map(([a, b]) => derivedView(a, b));

  return [...editorial, ...derived].map((view) => ({
    params: { slug: view.slug },
    props: { view },
  }));
}

const { view } = Astro.props as { view: ComparisonView };

const toolA = await getEntry('tools', view.toolA);
const toolB = await getEntry('tools', view.toolB);
if (!toolA || !toolB) {
  throw new Error(`Comparison ${view.slug} references a missing tool`);
}
---

<ComparisonPage locale="zh" view={view} toolA={toolA} toolB={toolB} />
