---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EcosystemChart from '../../components/EcosystemChart.astro';
import ParticleBackdrop from '../../components/ParticleBackdrop.astro';
import { categories, categoryKeys, t, SITE_URL, type CategoryKey } from '../../i18n/ui';

const locale = 'zh' as const;
const s = t(locale);
const tools = await getCollection('tools');
const byCat = (k: CategoryKey) =>
  tools
    .filter((x) => x.data.category === k)
    .sort((a, b) => (b.data.stars ?? 0) - (a.data.stars ?? 0));
const openCount = tools.filter((x) => !/proprietary|noassertion/i.test(x.data.license)).length;
const caveatCount = tools.filter((x) => x.data.caveat || x.data.archived).length;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: s.siteName,
    url: SITE_URL,
    description: s.intro,
    inLanguage: 'zh-CN',
  },
  { '@context': 'https://schema.org', '@type': 'Organization', name: s.siteName, url: SITE_URL },
];
---

<BaseLayout
  locale={locale}
  title={`${s.siteName} — ${s.tagline}`}
  description={s.intro}
  path="/zh/"
  alternates={{ en: '/', zh: '/zh/' }}
  jsonLd={jsonLd}
>
  <section class="relative overflow-hidden rounded-2xl border border-slate-200 bg-white px-6 py-12 dark:border-slate-800 dark:bg-slate-900 sm:px-10">
    <div
      class="pointer-events-none absolute -right-24 -top-24 h-64 w-64 rounded-full bg-indigo-500/10 blur-3xl"
    >
    </div>
    <ParticleBackdrop class="z-0" />
    <div class="relative z-10">
    <p class="inline-flex items-center gap-2 rounded-full border border-indigo-200 bg-indigo-50 px-3 py-1 text-xs font-medium text-indigo-700 dark:border-indigo-900 dark:bg-indigo-950/60 dark:text-indigo-300">
      {tools.length} 个工具 · {categoryKeys.length} 个分类 · 逐条核验
    </p>
    <h1 class="mt-4 max-w-3xl text-4xl font-bold tracking-tight text-slate-900 dark:text-slate-50 sm:text-5xl">
      {s.siteName}
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-slate-600 dark:text-slate-400">{s.intro}</p>

    <div class="mt-7 flex flex-wrap gap-3">
      <a
        href="/zh/tools/"
        class="btn border-transparent bg-indigo-600 text-white hover:bg-indigo-500"
      >
        浏览全部 {tools.length} 个工具 →
      </a>
      <a href="/zh/compare/langgraph-vs-crewai/" class="btn btn-ghost">LangGraph 对比 CrewAI</a>
    </div>

    <dl class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
      <div class="rounded-xl bg-slate-50 p-4 dark:bg-slate-950/60">
        <dt class="text-xs uppercase tracking-wide text-slate-500">工具</dt>
        <dd class="mt-1 text-2xl font-semibold text-slate-900 dark:text-slate-100">
          {tools.length}
        </dd>
      </div>
      <div class="rounded-xl bg-slate-50 p-4 dark:bg-slate-950/60">
        <dt class="text-xs uppercase tracking-wide text-slate-500">分类</dt>
        <dd class="mt-1 text-2xl font-semibold text-slate-900 dark:text-slate-100">
          {categoryKeys.length}
        </dd>
      </div>
      <div class="rounded-xl bg-slate-50 p-4 dark:bg-slate-950/60">
        <dt class="text-xs uppercase tracking-wide text-slate-500">开源 / 源码可见</dt>
        <dd class="mt-1 text-2xl font-semibold text-emerald-600 dark:text-emerald-400">
          {openCount}
        </dd>
      </div>
      <div class="rounded-xl bg-slate-50 p-4 dark:bg-slate-950/60">
        <dt class="text-xs uppercase tracking-wide text-slate-500">已标注注意项</dt>
        <dd class="mt-1 text-2xl font-semibold text-amber-600 dark:text-amber-400">
          {caveatCount}
        </dd>
      </div>
    </dl>
    </div>
  </section>

  <EcosystemChart locale={locale} />

  <section class="mt-14">
    <div class="flex items-end justify-between gap-4">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
        {s.allCategories}
      </h2>
      <a class="text-sm text-indigo-600 hover:underline dark:text-indigo-400" href="/zh/tools/"
        >全部工具 →</a
      >
    </div>

    <div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        categoryKeys.map((k) => (
          <a href={`/zh/categories/${k}/`} class="card card-interactive group flex flex-col">
            <div class="flex items-center justify-between">
              <h3 class="font-semibold text-slate-900 group-hover:text-indigo-600 dark:text-slate-100 dark:group-hover:text-indigo-400">
                {categories[k].zh}
              </h3>
              <span class="badge badge-neutral">{byCat(k).length}</span>
            </div>
            <ul class="mt-3 space-y-1 text-sm text-slate-600 dark:text-slate-400">
              {byCat(k)
                .slice(0, 3)
                .map((tool) => (
                  <li class="truncate">· {tool.data.name}</li>
                ))}
            </ul>
            <span class="mt-4 text-sm font-medium text-indigo-600 dark:text-indigo-400">
              {s.viewAll} →
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mt-14 rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">我们如何核验</h2>
    <ul class="mt-3 grid gap-3 text-sm text-slate-600 dark:text-slate-400 sm:grid-cols-3">
      <li class="rounded-lg bg-slate-50 p-4 dark:bg-slate-950/60">
        <strong class="block text-slate-900 dark:text-slate-200">可引用的判断句</strong>
        每条记录都以一句自包含的判断开头（主张 + 数字 + 日期 + 实体），便于 AI 脱离上下文直接引用。
      </li>
      <li class="rounded-lg bg-slate-50 p-4 dark:bg-slate-950/60">
        <strong class="block text-slate-900 dark:text-slate-200">数字由机器核对</strong>
        星标数与归档状态由脚本从 GitHub API 回填，绝不手写，且始终标注统计时点。
      </li>
      <li class="rounded-lg bg-slate-50 p-4 dark:bg-slate-950/60">
        <strong class="block text-slate-900 dark:text-slate-200">争议事实显式标注</strong>
        若某条广为流传的说法无法证实，我们以「注意」显式写出，而不是照抄传播。
      </li>
    </ul>
  </section>
</BaseLayout>
