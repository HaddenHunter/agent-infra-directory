---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PaperCard from '../../../components/PaperCard.astro';
import { t, SITE_URL, type Locale } from '../../../i18n/ui';
import {
  paperCategoryKeys,
  paperCategories,
  paperTiers,
  paperTopicUrl,
  paperUrl,
  type PaperCategory,
} from '../../../lib/papers';

const locale: Locale = 'zh';
const s = t(locale);

const all = await getCollection('papers');
/** 层级优先，层内按时间正序——里程碑读起来才像一条演进线。 */
const byTier = (tier: 'landmark' | 'frontier') =>
  all
    .filter((p) => p.data.tier === tier)
    .sort((a, b) => a.data.publishedDate.localeCompare(b.data.publishedDate));

const landmarks = byTier('landmark');
const frontier = byTier('frontier');

const counts = Object.fromEntries(
  paperCategoryKeys.map((k) => [k, all.filter((p) => p.data.category === k).length])
) as Record<PaperCategory, number>;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${s.papers} — ${s.siteName}`,
  url: `${SITE_URL}/zh/papers/`,
  numberOfItems: all.length,
  inLanguage: 'zh-CN',
};
---

<BaseLayout
  locale={locale}
  title={`${s.papers} — ${s.siteName}`}
  description={s.papersIntro}
  path="/zh/papers/"
  alternates={{ en: '/papers/', zh: '/zh/papers/' }}
  jsonLd={jsonLd}
>
  <header>
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-50">
      {s.papers}
    </h1>
    <p class="mt-2 max-w-3xl text-slate-600 dark:text-slate-400">{s.papersIntro}</p>
    <p class="mt-3 flex flex-wrap gap-2">
      <span class="badge badge-cat">{paperTiers.landmark.zh} {landmarks.length}</span>
      <span class="badge badge-open">{paperTiers.frontier.zh} {frontier.length}</span>
    </p>
  </header>

  <nav class="mt-6 flex flex-wrap items-center gap-2" aria-label="主题">
    <a class="text-sm text-indigo-600 hover:underline dark:text-indigo-400" href="/zh/papers/topics/">
      {s.topics} →
    </a>
    {
      paperCategoryKeys.map((k) => (
        <a class="badge badge-neutral" href={paperTopicUrl(locale, k)}>
          {paperCategories[k].zh} ({counts[k]})
        </a>
      ))
    }
  </nav>

  {
    (
      [
        ['landmark', landmarks],
        ['frontier', frontier],
      ] as const
    ).map(([tier, items]) => (
      <section class="mt-12">
        <div class="flex items-baseline gap-3">
          <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
            {paperTiers[tier].zh}
          </h2>
          <span class="text-sm text-slate-500">{items.length}</span>
        </div>
        <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {items.map((p) => (
            <PaperCard locale={locale} paper={p} href={paperUrl(locale, p.id)} />
          ))}
        </div>
      </section>
    ))
  }
</BaseLayout>
