---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { faqSchema } from '../../../lib/schema';
import { t, type Locale } from '../../../i18n/ui';
import {
  benchmarkCategories,
  benchmarkMarkdownUrl,
  benchmarkUrl,
} from '../../../lib/benchmarks';
import { verificationLabels, verificationBadge, type Verification } from '../../../lib/news';

export async function getStaticPaths() {
  const benchmarks = await getCollection('benchmarks');
  return benchmarks.map((b) => ({ params: { slug: b.id }, props: { benchmark: b } }));
}

const { benchmark } = Astro.props as {
  benchmark: Awaited<ReturnType<typeof getCollection<'benchmarks'>>>[number];
};
const locale: Locale = 'zh';
const s = t(locale);
const d = benchmark.data;

const name = d.name;
const description = d.descriptionZh;
const frontier = d.frontierZh;
const credibility = d.credibilityZh;
const catLabel = benchmarkCategories[d.category].zh;
const vLabel = verificationLabels[d.verification as Verification].zh;
const vClass = verificationBadge[d.verification as Verification];

const qas = [
  { q: `${name} 测的是什么？`, a: description },
  { q: `${name} 的 2026 年前沿水平是多少？`, a: frontier },
  { q: `${name} 可信吗？`, a: credibility },
];
if (d.debunksZh) {
  qas.push({ q: `关于 ${name} 的常见说法准确吗？`, a: d.debunksZh });
}
---

<BaseLayout
  locale={locale}
  title={`${name} — ${catLabel}`}
  description={description}
  path={benchmarkUrl('zh', benchmark.id)}
  alternates={{ en: benchmarkUrl('en', benchmark.id), zh: benchmarkUrl('zh', benchmark.id) }}
  jsonLd={faqSchema(qas)}
  ogType="article"
>
  <nav class="text-sm text-slate-500 dark:text-slate-400">
    <a class="hover:text-slate-900 dark:hover:text-slate-100" href="/zh/">{s.home}</a>
    <span class="mx-1">/</span>
    <a class="hover:text-slate-900 dark:hover:text-slate-100" href="/zh/benchmarks/">
      {s.benchmarks}
    </a>
  </nav>

  <header class="mt-3">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-50">{name}</h1>
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <span class="badge badge-cat">
        {d.category === 'contested' ? s.contested : catLabel}
      </span>
      <span class={`badge ${vClass}`}>{vLabel}</span>
      <span class="badge badge-neutral">{s.lastUpdated} {d.lastUpdated}</span>
    </div>
    <p class="mt-4 text-lg text-slate-600 dark:text-slate-400">{description}</p>
  </header>

  <blockquote class="key-fact mt-6">
    <p class="text-[15px] leading-relaxed">{d.keyFactZh}</p>
  </blockquote>

  {
    d.debunksZh && (
      <p class="alert-caveat mt-4">
        <strong>{s.contested}: </strong>
        {d.debunksZh}
      </p>
    )
  }

  <section class="mt-8">
    <h2 class="section-title">{s.facts}</h2>
    <table class="facts-table mt-3">
      <tbody>
        <tr>
          <th>{s.frontier}</th>
          <td>{frontier}</td>
        </tr>
        {
          d.humanBaseline && (
            <tr>
              <th>{s.humanBaseline}</th>
              <td>{d.humanBaseline}</td>
            </tr>
          )
        }
        <tr>
          <th>{s.credibility}</th>
          <td>{credibility}</td>
        </tr>
        <tr>
          <th>{s.verification}</th>
          <td>{vLabel}</td>
        </tr>
        <tr>
          <th>{s.newsSource}</th>
          <td>
            <a class="underline hover:text-indigo-600" href={d.sourceUrl} rel="nofollow noopener">
              {d.sourceName}
            </a>
          </td>
        </tr>
      </tbody>
    </table>
    <p class="mt-4 text-sm">
      <a
        class="btn btn-ghost"
        href={benchmarkMarkdownUrl(locale, benchmark.id)}
        data-astro-prefetch="false"
        rel="nofollow">{s.markdownVersion}</a
      >
    </p>
  </section>

  <section class="mt-10">
    <h2 class="section-title">FAQ</h2>
    <div class="mt-4 space-y-3">
      {
        qas.map(({ q, a }) => (
          <details class="card !p-0">
            <summary class="cursor-pointer px-4 py-3 font-medium text-slate-900 dark:text-slate-100">
              {q}
            </summary>
            <p class="px-4 pb-4 text-sm text-slate-600 dark:text-slate-400">{a}</p>
          </details>
        ))
      }
    </div>
  </section>
</BaseLayout>
