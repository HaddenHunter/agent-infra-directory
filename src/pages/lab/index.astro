---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, SITE_URL } from '../../i18n/ui';
import { labs, labUrl } from '../../lib/lab';

const locale = 'en' as const;
const s = t(locale);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Lab — ${s.siteName}`,
  url: `${SITE_URL}/lab/`,
  numberOfItems: labs.length,
  inLanguage: 'en',
};
---

<BaseLayout
  locale={locale}
  title={`Lab — ${s.siteName}`}
  description="Interactive experiments built on this directory's own dataset: a GPU-rendered ecosystem graph, an in-browser semantic search, and a walkthrough of the ReAct loop."
  path="/lab/"
  alternates={{ en: '/lab/', zh: '/zh/lab/' }}
  jsonLd={jsonLd}
>
  <nav class="text-sm text-slate-500 dark:text-slate-400">
    <a class="hover:text-slate-900 dark:hover:text-slate-100" href="/">{s.home}</a>
    <span class="mx-1">/</span>
    <span>Lab</span>
  </nav>

  <header class="mt-3">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-50">Lab</h1>
    <p class="mt-2 max-w-3xl text-slate-600 dark:text-slate-400">
      Interactive experiments built on this directory's own dataset. Each one lives on its own route
      and loads its own script, so the reference pages stay as light as they were.
    </p>
  </header>

  <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
    {
      labs.map((demo) => (
        <a href={labUrl(locale, demo.id)} class="card card-interactive group flex flex-col gap-3">
          <h2 class="font-semibold text-slate-900 group-hover:text-indigo-600 dark:text-slate-100 dark:group-hover:text-indigo-400">
            {demo.title[locale]}
          </h2>
          <p class="text-sm text-slate-600 dark:text-slate-400">{demo.blurb[locale]}</p>
          <p class="mt-auto text-xs text-slate-500 dark:text-slate-400">{demo.needs[locale]}</p>
        </a>
      ))
    }
  </div>
</BaseLayout>
