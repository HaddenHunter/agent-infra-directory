---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MythCard from '../../components/MythCard.astro';
import { t, SITE_URL, type Locale } from '../../i18n/ui';
import { collectMyths } from '../../lib/myths';

const locale: Locale = 'en';
const s = t(locale);

const [benchmarks, useCases, events] = await Promise.all([
  getCollection('benchmarks'),
  getCollection('useCases'),
  getCollection('events'),
]);
const { claims, flags } = collectMyths(locale, { benchmarks, useCases, events });

const total = claims.length + flags.length;
const latest = [...claims, ...flags].reduce((m, i) => (i.date > m ? i.date : m), '');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Claims that do not survive checking — ${s.siteName}`,
  url: `${SITE_URL}/myths/`,
  numberOfItems: total,
  inLanguage: 'en',
};
---

<BaseLayout
  locale={locale}
  title={`Claims that do not survive checking — ${s.siteName}`}
  description="Widely repeated claims about AI agents — numbers, stories and details — that have no traceable source or contradict the published evidence."
  path="/myths/"
  alternates={{ en: '/myths/', zh: '/zh/myths/' }}
  jsonLd={jsonLd}
>
  <nav class="text-sm text-slate-500 dark:text-slate-400">
    <a class="hover:text-slate-900 dark:hover:text-slate-100" href="/">{s.home}</a>
    <span class="mx-1">/</span>
    <span>Myths</span>
  </nav>

  <header class="mt-3">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-50">
      Claims that do not survive checking
    </h1>
    <p class="mt-2 max-w-3xl text-slate-600 dark:text-slate-400">
      Widely repeated numbers, stories and details about AI agents that have no traceable source,
      or that point the opposite way from the published evidence. Each item states the claim as it
      circulates, what the checking found, and the source it rests on.
    </p>
    <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
      {total} items · {s.lastUpdated} {latest}
    </p>
  </header>

  <section class="mt-10">
    <h2 class="section-title">
      Claims we could not stand behind
      <span class="ml-2 text-sm font-normal text-slate-500 dark:text-slate-400">{claims.length}</span>
    </h2>
    <div class="mt-4 grid gap-4 lg:grid-cols-2">
      {claims.map((item) => <MythCard locale={locale} item={item} />)}
    </div>
  </section>

  <section class="mt-12">
    <h2 class="section-title">
      Details that are commonly misreported
      <span class="ml-2 text-sm font-normal text-slate-500 dark:text-slate-400">{flags.length}</span>
    </h2>
    <p class="mt-2 max-w-3xl text-sm text-slate-600 dark:text-slate-400">
      In these entries the main story holds up, but a number or a detail that gets repeated
      alongside it does not. The entry's own citable judgment is the corrected version.
    </p>
    <div class="mt-4 grid gap-4 lg:grid-cols-2">
      {flags.map((item) => <MythCard locale={locale} item={item} />)}
    </div>
  </section>
</BaseLayout>
