---
import type { CollectionEntry } from 'astro:content';
import { categories, toolUrl, type Locale } from '../i18n/ui';
import { licenseKind, licenseLabels, licenseBadgeClass } from '../lib/license';

export interface Props {
  locale: Locale;
  tool: CollectionEntry<'tools'>;
  /** 是否在卡片上显示分类徽标（分类页内可关闭） */
  showCategory?: boolean;
}

const { locale, tool, showCategory = true } = Astro.props;
const d = tool.data;
const name = d.name;
const desc = locale === 'zh' ? d.descriptionZh : d.description;
const catLabel = categories[d.category][locale];
const kind = licenseKind(d.license);
const licLabel = licenseLabels[kind][locale];

const searchBlob = [
  name,
  d.description,
  d.descriptionZh,
  d.license,
  d.language,
  d.category,
  catLabel,
]
  .filter(Boolean)
  .join(' ')
  .toLowerCase();
---

<a
  href={toolUrl(locale, tool.id)}
  class="card card-interactive group flex flex-col gap-3"
  data-name={name}
  data-search={searchBlob}
  data-cat={d.category}
>
  <div class="flex items-start justify-between gap-2">
    <h3
      class="font-semibold leading-snug text-slate-900 group-hover:text-indigo-600
        dark:text-slate-100 dark:group-hover:text-indigo-400"
    >
      {name}
    </h3>
    {showCategory && <span class="badge badge-cat">{catLabel}</span>}
  </div>

  <p class="line-clamp-3 text-sm text-slate-600 dark:text-slate-400">{desc}</p>

  <div class="mt-auto flex flex-wrap items-center gap-2 pt-1">
    <span class={`badge ${licenseBadgeClass[kind]}`}>{licLabel}</span>
    {
      d.stars !== undefined && (
        <span class="badge badge-neutral">★ {d.stars.toLocaleString('en-US')}</span>
      )
    }
    {
      d.archived ? (
        <span class="badge badge-danger">{locale === 'zh' ? '已归档' : 'Archived'}</span>
      ) : (
        d.caveat && (
          <span class="badge badge-danger">{locale === 'zh' ? '有注意项' : 'Caveat'}</span>
        )
      )
    }
  </div>
</a>
