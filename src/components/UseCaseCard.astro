---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/ui';
import { useCaseScenarios, useCaseUrl } from '../lib/use-cases';
import { verificationBadge, verificationLabels, type Verification } from '../lib/news';

export interface Props {
  locale: Locale;
  useCase: CollectionEntry<'useCases'>;
}

const { locale, useCase } = Astro.props;
const d = useCase.data;
const zh = locale === 'zh';

const title = zh ? d.titleZh : d.title;
const summary = zh ? d.summaryZh : d.summary;
const vClass = verificationBadge[d.verification as Verification];
const vLabel = verificationLabels[d.verification as Verification][locale];
---

<a
  href={useCaseUrl(locale, useCase.id)}
  class="card card-interactive group flex flex-col gap-3"
  data-scenario={d.scenario}
>
  <div class="flex flex-wrap items-center gap-2">
    <span class="badge badge-cat">{useCaseScenarios[d.scenario][locale]}</span>
    <span class={`badge ${vClass}`}>{vLabel}</span>
    <span class="badge badge-neutral tabular-nums">{d.sourceDate}</span>
  </div>

  <h3
    class="font-semibold leading-snug text-slate-900 group-hover:text-indigo-600 dark:text-slate-100 dark:group-hover:text-indigo-400"
  >
    {title}
  </h3>

  <p class="text-sm text-slate-500 dark:text-slate-400">{d.product}</p>

  <p class="line-clamp-3 text-sm text-slate-600 dark:text-slate-400">{summary}</p>

  <p class="mt-auto text-xs text-slate-500 dark:text-slate-400">{d.sourceName}</p>
</a>
