---
import type { CollectionEntry } from 'astro:content';
import { t, type Locale } from '../i18n/ui';
import {
  eventTypes,
  verificationLabels,
  verificationBadge,
  type Verification,
} from '../lib/news';

export interface Props {
  locale: Locale;
  event: CollectionEntry<'events'>;
  /** 传入时标题变成指向详情页的链接；详情页自己不需要传 */
  detailHref?: string;
  /** 详情页把标题升成 h1：卡片在列表里是 h3，独立成页时 h3 会让页面没有一级标题 */
  titleTag?: 'h1' | 'h3';
}

const { locale, event, detailHref, titleTag = 'h3' } = Astro.props;
const Title = titleTag;
const d = event.data;
const s = t(locale);
const zh = locale === 'zh';
/** 中文用全角冒号，英文用半角——英文页面出现「：」是排版事故 */
const colon = zh ? '：' : ': ';

const title = locale === 'zh' ? d.titleZh : d.title;
const summary = locale === 'zh' ? d.summaryZh : d.summary;
const why = locale === 'zh' ? d.whyItMattersZh : d.whyItMatters;
const caveat = locale === 'zh' ? d.caveatZh : d.caveat;
const keyFact = locale === 'zh' ? d.keyFactZh : d.keyFact;
const typeLabel = eventTypes[d.type][locale];
const vLabel = verificationLabels[d.verification as Verification][locale];
const vClass = verificationBadge[d.verification as Verification];

const searchBlob = [d.title, d.titleZh, d.summary, d.summaryZh, d.sourceName, ...d.tags]
  .filter(Boolean)
  .join(' ')
  .toLowerCase();
---

<article
  id={event.id}
  class="card scroll-mt-24"
  data-type={d.type}
  data-search={searchBlob}
>
  <div class="flex flex-wrap items-center gap-2">
    <time datetime={d.eventDate} class="badge badge-neutral">{d.eventDate}</time>
    <span class="badge badge-cat">{typeLabel}</span>
    <span class={`badge ${vClass}`}>{vLabel}</span>
  </div>

  <Title
    class:list={[
      'mt-3 leading-snug font-semibold text-slate-900 dark:text-slate-100',
      titleTag === 'h1' ? 'text-3xl font-bold tracking-tight dark:text-slate-50' : 'text-lg',
    ]}
  >
    {
      detailHref ? (
        <a class="hover:text-indigo-600 dark:hover:text-indigo-400" href={detailHref}>
          {title}
        </a>
      ) : (
        title
      )
    }
  </Title>

  <blockquote class="key-fact mt-3 !p-3 text-sm">
    <p>{keyFact}</p>
  </blockquote>

  <p class="mt-3 text-sm text-slate-600 dark:text-slate-400">{summary}</p>

  {
    why && (
      <p class="mt-3 rounded-lg bg-slate-50 p-3 text-sm text-slate-700 dark:bg-slate-950/60 dark:text-slate-300">
        <strong class="text-slate-900 dark:text-slate-100">{s.whyItMatters}{colon}</strong>
        {why}
      </p>
    )
  }

  {
    d.details.length > 0 && (
      <table class="facts-table mt-3">
        <tbody>
          {d.details.map((row) => (
            <tr>
              <th>{locale === 'zh' ? row.labelZh : row.label}</th>
              <td>{row.value}</td>
            </tr>
          ))}
        </tbody>
      </table>
    )
  }

  {
    caveat && (
      <p class="alert-caveat mt-3">
        <strong>{locale === 'zh' ? '注意：' : 'Caveat: '}</strong>
        {caveat}
      </p>
    )
  }

  <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">
    {s.newsSource}{colon}
    <a class="underline hover:text-indigo-600" href={d.sourceUrl} rel="nofollow noopener">
      {d.sourceName}
    </a>
  </p>
</article>
