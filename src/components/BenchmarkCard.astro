---
import type { CollectionEntry } from 'astro:content';
import { t, type Locale } from '../i18n/ui';
import { benchmarkCategories } from '../lib/benchmarks';
import { verificationLabels, verificationBadge, type Verification } from '../lib/news';

export interface Props {
  locale: Locale;
  benchmark: CollectionEntry<'benchmarks'>;
  href: string;
}

const { locale, benchmark, href } = Astro.props;
const d = benchmark.data;
const s = t(locale);

const name = d.name;
const description = locale === 'zh' ? d.descriptionZh : d.description;
const frontier = locale === 'zh' ? d.frontierZh : d.frontier;
const credibility = locale === 'zh' ? d.credibilityZh : d.credibility;
const catLabel = benchmarkCategories[d.category][locale];
const vLabel = verificationLabels[d.verification as Verification][locale];
const vClass = verificationBadge[d.verification as Verification];
---

<a href={href} class="card card-interactive group flex flex-col gap-3" data-cat={d.category}>
  <div class="flex flex-wrap items-center gap-2">
    <span class="badge badge-cat">
      {d.category === 'contested' ? s.contested : catLabel}
    </span>
    <span class={`badge ${vClass}`}>{vLabel}</span>
  </div>

  <h3 class="font-semibold leading-snug text-slate-900 group-hover:text-indigo-600 dark:text-slate-100 dark:group-hover:text-indigo-400">
    {name}
  </h3>

  <p class="line-clamp-3 text-sm text-slate-600 dark:text-slate-400">{description}</p>

  <p class="mt-auto text-sm">
    <span class="font-medium text-slate-500 dark:text-slate-400">{s.frontier}：</span>
    <span class="text-slate-700 dark:text-slate-300">{frontier}</span>
  </p>

  <p class="line-clamp-3 text-xs text-slate-500 dark:text-slate-400">{credibility}</p>
</a>
