---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t, type Locale } from '../i18n/ui';
import { glossaryTerms, glossaryUrl } from '../lib/glossary';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
const zh = locale === 'zh';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: zh ? 'AI Agent 基础设施术语表' : 'AI agent infrastructure glossary',
  description: s.glossaryIntro,
  url: zh ? 'https://agent.c8.fit/zh/glossary/' : 'https://agent.c8.fit/glossary/',
  inLanguage: zh ? 'zh-CN' : 'en',
  hasDefinedTerm: glossaryTerms.map((term) => ({
    '@type': 'DefinedTerm',
    name: term.term[locale],
    url: zh
      ? `https://agent.c8.fit/zh/glossary/${term.slug}/`
      : `https://agent.c8.fit/glossary/${term.slug}/`,
  })),
};
---

<BaseLayout
  locale={locale}
  title={`${s.glossary} — ${s.siteName}`}
  description={s.glossaryIntro}
  path={zh ? '/zh/glossary/' : '/glossary/'}
  alternates={{ en: '/glossary/', zh: '/zh/glossary/' }}
  jsonLd={jsonLd}
>
  <nav class="text-sm text-slate-500 dark:text-slate-400">
    <a class="hover:text-slate-900 dark:hover:text-slate-100" href={zh ? '/zh/' : '/'}>{s.home}</a>
    <span class="mx-1">/</span><span>{s.glossary}</span>
  </nav>

  <header class="mt-3">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-50">{s.glossary}</h1>
    <p class="mt-2 max-w-3xl text-slate-600 dark:text-slate-400">{s.glossaryIntro}</p>
  </header>

  <ul class="mt-8 grid gap-4 md:grid-cols-2">
    {
      glossaryTerms.map((term) => (
        <li>
          <a class="card card-interactive block h-full" href={glossaryUrl(locale, term.slug)}>
            <h2 class="font-semibold text-slate-900 dark:text-slate-100">{term.term[locale]}</h2>
            {term.aka && (
              <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">
                {zh ? '亦称' : 'Also'} {term.aka[locale]}
              </p>
            )}
            <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
              {term.definition[locale]}
            </p>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
