---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories, t, toolUrl, type Locale } from '../i18n/ui';
import { paperUrl } from '../lib/papers';
import { glossaryIndexUrl, type GlossaryTerm } from '../lib/glossary';

export interface Props {
  locale: Locale;
  entry: GlossaryTerm;
}

const { locale, entry } = Astro.props;
const s = t(locale);
const zh = locale === 'zh';

const [tools, papers] = await Promise.all([getCollection('tools'), getCollection('papers')]);
const toolById = new Map(tools.map((x) => [x.id, x]));
const paperById = new Map(papers.map((x) => [x.id, x]));

/**
 * 词条引用的 id 在这里跟集合比对一次：对不上就不渲染该链接。
 * 术语表是手工维护的，写错 id 时宁可少一个链接，也不要让读者点进 404。
 */
const relatedTools = (entry.tools ?? [])
  .map((id) => toolById.get(id))
  .filter((x): x is NonNullable<typeof x> => Boolean(x));
const relatedPapers = (entry.papers ?? [])
  .map((id) => paperById.get(id))
  .filter((x): x is NonNullable<typeof x> => Boolean(x));
const relatedCategories = entry.categories ?? [];

const term = entry.term[locale];
const aka = entry.aka?.[locale];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  name: entry.term.en,
  description: entry.definition.en,
  inDefinedTermSet: {
    '@type': 'DefinedTermSet',
    name: 'AI agent infrastructure glossary',
    url: 'https://agent.c8.fit/glossary/',
  },
  url: zh ? `https://agent.c8.fit/zh/glossary/${entry.slug}/` : `https://agent.c8.fit/glossary/${entry.slug}/`,
};
---

<BaseLayout
  locale={locale}
  title={`${term} — ${s.glossary}`}
  description={entry.definition[locale]}
  path={zh ? `/zh/glossary/${entry.slug}/` : `/glossary/${entry.slug}/`}
  alternates={{
    en: `/glossary/${entry.slug}/`,
    zh: `/zh/glossary/${entry.slug}/`,
  }}
  jsonLd={jsonLd}
  ogType="article"
>
  <nav class="text-sm text-slate-500 dark:text-slate-400">
    <a class="hover:text-slate-900 dark:hover:text-slate-100" href={zh ? '/zh/' : '/'}>{s.home}</a>
    <span class="mx-1">/</span>
    <a class="hover:text-slate-900 dark:hover:text-slate-100" href={glossaryIndexUrl(locale)}>
      {s.glossary}
    </a>
  </nav>

  <header class="mt-3">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-50">{term}</h1>
    {aka && <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">{zh ? '亦称' : 'Also'} {aka}</p>}
    <p class="mt-4 max-w-3xl text-lg leading-relaxed text-slate-700 dark:text-slate-300">
      {entry.definition[locale]}
    </p>
  </header>

  {
    relatedCategories.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-2">
        {relatedCategories.map((key) => (
          <a
            class="badge badge-cat"
            href={locale === 'zh' ? `/zh/categories/${key}/` : `/categories/${key}/`}
          >
            {categories[key][locale]}
          </a>
        ))}
      </div>
    )
  }

  {
    relatedTools.length > 0 && (
      <section class="mt-12">
        <h2 class="section-title">{s.relatedInDirectory}</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {relatedTools.map((tool) => (
            <li>
              <a class="card card-interactive block !p-4" href={toolUrl(locale, tool.id)}>
                <span class="font-medium text-slate-900 dark:text-slate-100">{tool.data.name}</span>
                <span class="mt-1 block text-sm text-slate-600 dark:text-slate-400">
                  {locale === 'zh' ? tool.data.descriptionZh : tool.data.description}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    relatedPapers.length > 0 && (
      <section class="mt-12">
        <h2 class="section-title">{s.relatedPapers}</h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {relatedPapers.map((paper) => (
            <li>
              <a class="badge badge-neutral" href={paperUrl(locale, paper.id)}>
                {paper.data.name}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <p class="mt-12 max-w-3xl text-xs leading-relaxed text-slate-500 dark:text-slate-400">
    {
      zh
        ? '术语定义属于解释性内容，本身不挂核验状态——本目录的核验状态只标注工具、基准、动态与用例四类条目。上面的链接全部指向本目录内的条目。'
        : 'Glossary definitions are explanatory and carry no verification status of their own; the verification flags in this directory apply to tool, benchmark, news and use-case entries. Every link above points to an entry inside this directory.'
    }
  </p>
</BaseLayout>
