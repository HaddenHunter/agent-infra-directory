---
import type { CollectionEntry } from 'astro:content';
import { t, type Locale } from '../i18n/ui';
import { paperCategories, paperTiers } from '../lib/papers';

export interface Props {
  locale: Locale;
  paper: CollectionEntry<'papers'>;
  href: string;
}

const { locale, paper, href } = Astro.props;
const d = paper.data;
const s = t(locale);

const title = locale === 'zh' ? d.titleZh : d.title;
const summary = locale === 'zh' ? d.summaryZh : d.summary;
const firstAuthor = d.authors[0] ?? '';
const coAuthors = d.authors.length - 1;
---

<a
  href={href}
  class="card card-interactive group flex flex-col gap-3"
  data-cat={d.category}
  data-tier={d.tier}
>
  <div class="flex flex-wrap items-center gap-2">
    <span class={`badge ${d.tier === 'landmark' ? 'badge-cat' : 'badge-open'}`}>
      {paperTiers[d.tier][locale]}
    </span>
    <span class="badge badge-neutral">{paperCategories[d.category][locale]}</span>
    <span class="badge badge-neutral tabular-nums">{d.publishedDate.slice(0, 4)}</span>
  </div>

  <h3
    class="font-semibold leading-snug text-slate-900 group-hover:text-indigo-600 dark:text-slate-100 dark:group-hover:text-indigo-400"
  >
    {d.name}
  </h3>

  <p class="text-sm text-slate-500 dark:text-slate-400">{title}</p>

  <p class="line-clamp-3 text-sm text-slate-600 dark:text-slate-400">{summary}</p>

  <p class="mt-auto text-xs text-slate-500 dark:text-slate-500">
    {firstAuthor}{coAuthors > 0 ? ` +${coAuthors}` : ''} · arXiv:{d.arxivId}
  </p>
</a>
